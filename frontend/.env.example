# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Supabase — use the ROTATED anon (public) key. RLS makes this safe in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-rotated-anon-public-key

# Legacy Laravel API (being retired in favour of Supabase). Leave unset in prod.
# VITE_API_URL=
